<Entity>
	
	<Base file="data/entities/base_custom_card.xml" > 
		<SpriteComponent 
			image_file="mods/stab/files/ui_gfx/gun_actions/buff.png"
			>
		</SpriteComponent>
		
		<ItemActionComponent 
			_tags="enabled_in_world"
			action_id="STAB_BUFF" >
		</ItemActionComponent>
	</Base>

	<InheritTransformComponent
		_tags="enabled_in_world,enabled_in_hand" >
	</InheritTransformComponent>

	<VariableStorageComponent
		_tags="stab_frame"
		name="stab_frame"
		value_int="0"
	></VariableStorageComponent>

	<SpriteParticleEmitterComponent
		_tags="stab"
		_enabled="0"
		sprite_file=""
		sprite_centered="1"
		delay="0"
		lifetime="0"
		color.r="0.9" color.g="0.5" color.b="1" color.a="0.9"
		color_change.r="0" color_change.g="0" color_change.b="0" color_change.a="0"
    	velocity.x="0" velocity.y="0"
        gravity.x="0" gravity.y="0"
        velocity_slowdown="0"
        rotation="0"
        angular_velocity="0"
		use_rotation_from_entity="0"
        use_velocity_as_rotation="0"
        scale.x="1" scale.y="1"
        scale_velocity.x="0" scale_velocity.y="0"
        emission_interval_min_frames="0"
        emission_interval_max_frames="0"
        count_min="1" count_max="1"
        randomize_rotation.min="0"
        randomize_rotation.max="0"
        randomize_angular_velocity.min="0"
        randomize_angular_velocity.max="0"
        randomize_position.min_x="7"
        randomize_position.max_x="7"
        randomize_position.min_y="-12"
        randomize_position.max_y="-12"
        randomize_velocity.min_x="0"
        randomize_velocity.max_x="0"
        randomize_velocity.min_y="0"
        randomize_velocity.max_y="0"
        velocity_always_away_from_center="1" >
	</SpriteParticleEmitterComponent>

    <LuaComponent
        _tags="enabled_in_hand"
        script_source_file="mods/stab/files/entities/misc/card_stab/in_hand.lua"
        execute_every_n_frame="1"
    ></LuaComponent>

	<LuaComponent
		_tags="enabled_in_inventory,enabled_in_world"
        script_source_file="mods/stab/files/entities/misc/card_stab/card.lua"
        execute_every_n_frame="1"
    ></LuaComponent>

</Entity>